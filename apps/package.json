{
  "name": "summit-apps",
  "private": true,
  "description": "npm workspace root for the Summit apps. Lives in apps/ (not the repo root — the repo root is the home directory).",
  "workspaces": ["core", "daily", "fitness", "eat"],
  "scripts": {
    "dev:daily": "npm run dev -w daily",
    "dev:fitness": "npm run dev -w fitness -- --port 5174",
    "dev:eat": "npm run dev -w eat -- --port 5175",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
